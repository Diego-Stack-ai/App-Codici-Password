rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId && isRecoveryUnlocked(userId);
    }

    function hasVerifiedEmail() {
      return request.auth != null &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 3;
    }

    function isBoundGuest(account) {
      return hasVerifiedEmail() && isRecoveryUnlocked(request.auth.uid) &&
        request.auth.uid in account.data.get('sharedWithUids', []) &&
        account.data.get('sharedWithEmailByUid', {}).get(request.auth.uid, '').lower() ==
          request.auth.token.email.lower();
    }

    function isRecoveryUnlocked(userId) {
      let path = /databases/(default)/documents/vaultRecoveryLocks/$(userId);
      let lock = firestore.get(path);
      return !firestore.exists(path) || (
        lock.data.get('schemaVersion', 0) == 1 &&
        lock.data.get('ownerUid', '') == userId &&
        lock.data.get('status', '') == 'released' &&
        lock.data.get('operationId', '') is string &&
        lock.data.get('operationId', '').matches('^[A-Za-z0-9._:-]{1,160}$') &&
        lock.data.get('planDigest', '') is string &&
        lock.data.get('planDigest', '').matches('^[a-f0-9]{64}$') &&
        lock.data.get('digest', '') is string &&
        lock.data.get('digest', '').matches('^[a-f0-9]{64}$') &&
        userId.matches('^[A-Za-z0-9._:-]{1,160}$') &&
        lock.data.get('digest', '') == hashing.sha256(
          '[1,"' + userId + '","' + lock.data.get('operationId', '') + '","' +
          lock.data.get('planDigest', '') + '"]'
        ).toHexString().lower()
      );
    }
    function isGlobalPurgeUnlocked(userId) {
      let path = /databases/(default)/documents/archivePurgeLocks/$(userId);
      let lock = firestore.get(path);
      return isRecoveryUnlocked(userId) && (!firestore.exists(path) || (
        lock.data.get('schemaVersion', 0) == 1 &&
        lock.data.get('ownerUid', '') == userId &&
        lock.data.get('status', '') == 'released'
      ));
    }

    function isAllowedUpload() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 32 * 1024 * 1024 +
          (request.resource.contentType == 'application/octet-stream' ? 1024 : 0) &&
        request.resource.contentType is string &&
        request.resource.contentType.matches(
          '^(image/(jpeg|png|gif|webp|heic|heif)|video/(mp4|quicktime|webm)|application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|vnd\\.ms-excel|vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)|text/plain|application/octet-stream)$'
        ) &&
        (request.resource.contentType != 'application/octet-stream' ||
          ('encrypted' in request.resource.metadata &&
            request.resource.metadata.encrypted == 'v1'));
    }

    function isAcceptedPrivateAccountGuest(userId, accountId) {
      let path = /databases/(default)/documents/users/$(userId)/accounts/$(accountId);
      let account = firestore.get(path);
      return isRecoveryUnlocked(userId) && firestore.exists(path) && account.data.get('isArchived', false) == false &&
        isBoundGuest(account);
    }

    function isAcceptedCompanyAccountGuest(userId, companyId, accountId) {
      let path = /databases/(default)/documents/users/$(userId)/aziende/$(companyId)/accounts/$(accountId);
      let account = firestore.get(path);
      return isRecoveryUnlocked(userId) && firestore.exists(path) && account.data.get('isArchived', false) == false &&
        isBoundGuest(account);
    }

    // Materiale editoriale dell'app: leggibile esclusivamente dopo il login.
    // Il client non può creare, sostituire o cancellare questi file.
    match /app-media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Il destinatario può scaricare soltanto i byte cifrati dell'Account ancora
    // condiviso. La decifratura richiede inoltre la sua busta personale salvata
    // nei metadati Firestore; la revoca dell'ACL blocca subito il download.
    match /users/{userId}/accounts/{accountId}/attachments/{allPaths=**} {
      allow read: if isRecoveryUnlocked(userId) && (isOwner(userId) || isAcceptedPrivateAccountGuest(userId, accountId));
    }

    match /users/{userId}/aziende/{companyId}/accounts/{accountId}/attachments/{allPaths=**} {
      allow read: if isRecoveryUnlocked(userId) && (isOwner(userId) || isAcceptedCompanyAccountGuest(userId, companyId, accountId));
    }

    // Namespace server-only per gli allegati cifrati dei documenti personali.
    // Il client proprietario può scaricare i byte opachi, mai crearli o rimuoverli.
    match /users/{userId}/profile-documents/{documentId}/attachments/{attachmentId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Tutti gli oggetti applicativi sono confinati nello spazio dell'UID.
    // La lettura resta limitata al proprietario: la condivisione degli allegati
    // richiederà un protocollo crittografico dedicato nella fase P3.
    match /users/{userId}/{namespace}/{allPaths=**} {
      allow read: if isOwner(userId) && namespace != 'restoreObjects' && namespace != 'profile-documents';
      allow delete: if isOwner(userId) && isGlobalPurgeUnlocked(userId) &&
        namespace != 'restoreObjects' && namespace != 'profile-documents';
      allow create, update: if isOwner(userId) && isGlobalPurgeUnlocked(userId) &&
        namespace != 'restoreObjects' && namespace != 'profile-documents' && isAllowedUpload();
    }

    // Reserved M8 namespace. Creation must use the server's Storage generation
    // precondition, not a client-side existence check (concurrent uploads race).
    // No client, including the owner, may create, replace or remove these bytes.
    match /users/{userId}/restoreObjects/{objectId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Chiusura esplicita per qualsiasi percorso non riconosciuto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
