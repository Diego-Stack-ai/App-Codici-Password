rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() { return request.auth != null; }
    function myEmail() { return (request.auth.token.email || "").lower(); }

    // --- 1. UTENTI & PROPRIETARIO (ACCESSO TOTALE) ---
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // --- 2. ACCESSO OSPITI (SHARED DATA) ---
    match /users/{userId}/accounts/{accountId} {
      allow read, update: if isAuth() && (
        resource.data.get('visibility', 'private') == 'shared' || 
        resource.data.get('shared', false) == true ||
        resource.data.get('isMemoShared', false) == true
      );
    }
    match /users/{userId}/aziende/{aziendaId}/accounts/{accountId} {
      allow read, update: if isAuth() && (
        resource.data.get('visibility', 'private') == 'shared' || 
        resource.data.get('shared', false) == true ||
        resource.data.get('isMemoShared', false) == true
      );
    }

    // --- 2b. COLLECTIONGROUP ACCOUNTS (ACCESSO OSPITI VIA CONDIVISIONE) ---
    // Protegge da IDOR: un utente può leggere un account altrui solo se è in sharedWith
    match /{path=**}/accounts/{accountId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.get('sharedWith', {}) ||
        resource.data.get('visibility', 'private') == 'shared'
      );
    }

    // Notifiche (Permetti invio da terzi per risposte condivisione)
    match /users/{userId}/notifications/{notifId} {
      allow create: if isAuth(); 
    }

    // --- 3. INVITI (INVITES) ---
    match /invites/{inviteId} {
      // Lettura singolo invito: solo owner, sender o destinatario
      allow read, update, delete: if isAuth() && (
        resource == null ||
        resource.data.get('ownerId', '') == request.auth.uid || 
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('recipientEmail', '').lower() == myEmail()
      );
      // Creazione: utente autenticato, solo campi consentiti dalla whitelist
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly(['recipientEmail','accountId','accountName','ownerId','senderId','aziendaId','type','status','createdAt']) &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        request.resource.data.get('status', '') == 'pending';
      // List/query: solo i propri inviti (come mittente o destinatario)
      allow list: if isAuth() && (
        request.query.filters.size() > 0
      );
    }
  }
}

