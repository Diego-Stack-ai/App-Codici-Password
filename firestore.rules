rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId; }
    function myEmail() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : "";
    }
    function isAcceptedGuest() {
      return isAuth() && request.auth.uid in resource.data.get('sharedWithUids', []);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/pushDevices/{deviceId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) &&
        deviceId.matches('^[a-fA-F0-9-]{36}$') &&
        request.resource.data.keys().hasOnly([
          'token', 'platform', 'browser', 'enabled', 'notificationScope',
          'privacyMode', 'schemaVersion', 'updatedAt', 'lastSeenAt', 'createdAt'
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.token.size() < 4096 &&
        request.resource.data.platform in ['windows', 'android', 'ios', 'other'] &&
        request.resource.data.browser is string &&
        request.resource.data.browser.size() < 200 &&
        request.resource.data.enabled is bool &&
        request.resource.data.notificationScope == 'deadlines' &&
        request.resource.data.privacyMode in ['detailed', 'discreet'] &&
        request.resource.data.schemaVersion == 1;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'platform', 'browser', 'enabled', 'notificationScope',
          'privacyMode', 'schemaVersion', 'updatedAt', 'lastSeenAt', 'createdAt'
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.token.size() < 4096 &&
        request.resource.data.platform in ['windows', 'android', 'ios', 'other'] &&
        request.resource.data.browser is string &&
        request.resource.data.browser.size() < 200 &&
        request.resource.data.enabled is bool &&
        request.resource.data.notificationScope == 'deadlines' &&
        request.resource.data.privacyMode in ['detailed', 'discreet'] &&
        request.resource.data.schemaVersion == 1;
    }

    match /users/{userId}/notificationDeliveries/{deliveryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/deadlineNotifications/{notificationId} {
      allow read: if isOwner(userId);
      allow create, delete: if false;
      allow update: if isOwner(userId) &&
        resource.data.status == 'unread' &&
        request.resource.data.status == 'viewed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt']);
    }

    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if isOwner(userId) &&
        collection != 'pushDevices' &&
        collection != 'notificationDeliveries' &&
        collection != 'deadlineNotifications';
    }

    match /users/{userId}/accounts/{accountId} {
      allow get, list: if isAcceptedGuest();
    }
    match /users/{userId}/aziende/{aziendaId}/accounts/{accountId} {
      allow get, list: if isAcceptedGuest();
    }
    match /{path=**}/accounts/{accountId} {
      allow get, list: if isAcceptedGuest();
    }

    match /invites/{inviteId} {
      function isInviteOwner() {
        return isAuth() && (
          resource.data.get('ownerId', '') == request.auth.uid ||
          resource.data.get('senderId', '') == request.auth.uid
        );
      }
      function isRecipient() {
        return isAuth() && resource.data.get('recipientEmail', '').lower() == myEmail();
      }

      allow get, list: if isInviteOwner() || isRecipient();
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly([
          'inviteId', 'recipientEmail', 'accountId', 'accountName',
          'ownerId', 'senderId', 'senderEmail', 'aziendaId', 'type',
          'status', 'createdAt'
        ]) &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        request.resource.data.get('senderId', '') == request.auth.uid &&
        request.resource.data.get('senderEmail', '').lower() == myEmail() &&
        request.resource.data.get('recipientEmail', '') is string &&
        request.resource.data.get('recipientEmail', '').size() > 3 &&
        request.resource.data.get('status', '') == 'pending';

      allow update, delete: if isInviteOwner();
    }
  }
}

