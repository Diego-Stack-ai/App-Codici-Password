rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId; }
    function myEmail() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : "";
    }
    function isAcceptedGuest() {
      return isAuth() && request.auth.uid in resource.data.get('sharedWithUids', []);
    }
    // M7-R7B1a: un Account nell'Archivio è sospeso per gli ospiti, in lettura e
    // in elenco. Il confronto è esplicito (`== false`) perché un valore
    // malformato non apra la lettura. Il proprietario non passa da queste regole
    // (match generico proprietario) e conserva l'accesso all'Archivio; inviti e
    // campi `sharedWith`/`sharedWithUids` non vengono toccati da questa condizione.
    function isGuestReadableAccount() {
      return isAcceptedGuest() && resource.data.get('isArchived', false) == false;
    }
    function isAcceptedPrivateAccountGuest(userId, accountId) {
      let path = /databases/$(database)/documents/users/$(userId)/accounts/$(accountId);
      let account = get(path);
      return isAuth() && exists(path) && account.data.get('isArchived', false) == false &&
        request.auth.uid in account.data.get('sharedWithUids', []);
    }
    function isAcceptedCompanyAccountGuest(userId, companyId, accountId) {
      let path = /databases/$(database)/documents/users/$(userId)/aziende/$(companyId)/accounts/$(accountId);
      let account = get(path);
      return isAuth() && exists(path) && account.data.get('isArchived', false) == false &&
        request.auth.uid in account.data.get('sharedWithUids', []);
    }
    function hasSafeRecipientAttachmentEnvelope() {
      // Questo indice viene scritto dalla Cloud Function soltanto nella stessa
      // operazione che pubblica la busta personale ed elimina il vecchio URL.
      // Essendo un array, Firestore può verificare anche le query di elenco.
      return request.auth.uid in resource.data.get('sharedReadyRecipientUids', []);
    }

    // Solo Cloud Functions (Admin SDK) può leggere o scrivere i codici di recupero.
    match /mfaRecovery/{userId} {
      allow read, write: if false;
    }

    match /mfaRecoveryAttempts/{attemptId} {
      allow read, write: if false;
    }

    // Indice tecnico degli UID usato solo dal backend per revocare copie ricevute.
    match /deadlineShares/{shareId} {
      allow read, write: if false;
    }

    // Esiti delle mutazioni attestati dal backend. Il namespace non eredita
    // le autorizzazioni generiche delle raccolte proprietario.
    match /mutationResults/{userId}/operations/{operationId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/pushDevices/{deviceId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) &&
        deviceId.matches('^[a-fA-F0-9-]{36}$') &&
        request.resource.data.keys().hasOnly([
          'token', 'platform', 'browser', 'enabled', 'notificationScope', 'notificationScopes',
          'privacyMode', 'schemaVersion', 'updatedAt', 'lastSeenAt', 'createdAt'
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.token.size() < 4096 &&
        request.resource.data.platform in ['windows', 'android', 'ios', 'other'] &&
        request.resource.data.browser is string &&
        request.resource.data.browser.size() < 200 &&
        request.resource.data.enabled is bool &&
        request.resource.data.notificationScope == 'deadlines' &&
        request.resource.data.notificationScopes is list &&
        request.resource.data.notificationScopes.hasOnly(['deadlines', 'sharing']) &&
        request.resource.data.privacyMode in ['detailed', 'discreet'] &&
        request.resource.data.schemaVersion == 1;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'platform', 'browser', 'enabled', 'notificationScope', 'notificationScopes',
          'privacyMode', 'schemaVersion', 'updatedAt', 'lastSeenAt', 'createdAt'
        ]) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.token.size() < 4096 &&
        request.resource.data.platform in ['windows', 'android', 'ios', 'other'] &&
        request.resource.data.browser is string &&
        request.resource.data.browser.size() < 200 &&
        request.resource.data.enabled is bool &&
        request.resource.data.notificationScope == 'deadlines' &&
        request.resource.data.notificationScopes is list &&
        request.resource.data.notificationScopes.hasOnly(['deadlines', 'sharing']) &&
        request.resource.data.privacyMode in ['detailed', 'discreet'] &&
        request.resource.data.schemaVersion == 1;
    }

    match /users/{userId}/notificationDeliveries/{deliveryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/deadlineNotifications/{notificationId} {
      allow read: if isOwner(userId);
      allow create, delete: if false;
      allow update: if isOwner(userId) &&
        resource.data.status == 'unread' &&
        request.resource.data.status == 'viewed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt']);
    }

    // Copia minima di una scadenza ricevuta. Il client può leggerla, mentre
    // creazione, sincronizzazione e gestione passano esclusivamente dal backend.
    match /users/{userId}/receivedDeadlines/{receivedDeadlineId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Esiti storici: consultabili, ma mai creabili o alterabili dal client.
    // Il blocco non certifica la provenienza dei documenti già esistenti.
    match /users/{userId}/operationResults/{operationId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // M7-AUDIT-2 — Registro tecnico di audit: il proprietario lo consulta, ma
    // nessun client può creare, modificare o cancellare eventi (decisione M7-R3:
    // scrittore è solo il backend, che ignora le Rules). Serve anche l'esclusione
    // dal catch-all qui sotto: regole sovrapposte si combinano in OR, quindi un
    // diniego specifico non annullerebbe una concessione più ampia.
    match /users/{userId}/auditEvents/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if isOwner(userId) &&
        collection != 'aziende' &&
        collection != 'auditEvents' &&
        collection != 'contacts' &&
        collection != 'pushDevices' &&
        collection != 'notificationDeliveries' &&
        collection != 'deadlineNotifications' &&
        collection != 'receivedDeadlines' &&
        collection != 'operationResults' &&
        collection != 'profileWidgets' &&
        collection != 'accountWidgets' &&
        collection != 'sharedVaultData' &&
        collection != 'sharedVaultLinks' &&
        collection != 'cryptoIdentity';
    }

    // Identità ECDH M5: soltanto la chiave pubblica è leggibile dagli utenti
    // autenticati. La busta privata è leggibile esclusivamente dal suo titolare;
    // entrambe sono create dal backend e non sostituibili dal client.
    match /cryptoPublicKeys/{userId} {
      allow get: if isAuth();
      allow list, write: if false;
    }

    match /users/{userId}/cryptoIdentity/{identityId} {
      allow get: if isOwner(userId) && identityId == 'current';
      allow list, write: if false;
    }

    // Company deletion must use the coordinated server protocol. A stale or
    // custom client must not bypass the UI guard and orphan its Accounts.
    match /users/{userId}/aziende/{companyId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
      // Preserve existing descendant permissions, not a recursive grant on the
      // company document itself (recursive wildcards also match zero segments).
      match /{childCollection}/{childDocument}/{rest=**} {
        allow read, update, delete: if isOwner(userId);
        // Require the Company in the resulting atomic state. This also permits
        // a legitimate batch that creates Company and Account together.
        allow create: if isOwner(userId) && (childCollection != 'accounts' ||
          existsAfter(/databases/$(database)/documents/users/$(userId)/aziende/$(companyId)));
      }
    }

    match /users/{userId}/contacts/{contactId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /users/{userId}/profileWidgets/{widgetId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'title', 'description', 'icon', 'color', 'tab', 'order', 'size',
          'collapsed', 'fields', 'updatedAt', 'schemaVersion'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 500 &&
        request.resource.data.tab in ['personal', 'contacts', 'addresses', 'documents'] &&
        request.resource.data.size in ['small', 'medium', 'wide'] &&
        request.resource.data.order is int &&
        request.resource.data.collapsed is bool &&
        request.resource.data.fields is list &&
        request.resource.data.fields.size() <= 30 &&
        request.resource.data.schemaVersion == 1;
    }

    // Nuovi domini predisposti per Widget Account e Credenziali comuni.
    // Le letture appartengono al proprietario; finché le funzioni atomiche non
    // sono implementate, nessun client può creare collegamenti parziali.
    match /users/{userId}/accountWidgets/{widgetId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/sharedVaultData/{sharedDataId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/sharedVaultLinks/{linkId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/accounts/{accountId} {
      allow get, list: if isGuestReadableAccount();
    }
    match /users/{userId}/accounts/{accountId}/attachments/{attachmentId} {
      allow get, list: if isAcceptedPrivateAccountGuest(userId, accountId) &&
        hasSafeRecipientAttachmentEnvelope();
    }
    match /users/{userId}/aziende/{aziendaId}/accounts/{accountId} {
      allow get, list: if isGuestReadableAccount();
    }
    match /users/{userId}/aziende/{aziendaId}/accounts/{accountId}/attachments/{attachmentId} {
      allow get, list: if isAcceptedCompanyAccountGuest(userId, aziendaId, accountId) &&
        hasSafeRecipientAttachmentEnvelope();
    }
    match /{path=**}/accounts/{accountId} {
      allow get, list: if isGuestReadableAccount();
    }

    match /invites/{inviteId} {
      function isInviteOwner() {
        return isAuth() && (
          resource.data.get('ownerId', '') == request.auth.uid ||
          resource.data.get('senderId', '') == request.auth.uid
        );
      }
      function isRecipient() {
        return isAuth() && resource.data.get('recipientEmail', '').lower() == myEmail();
      }
      // M7-AUDIT-5R — forma del marcatore opaco dell'istanza di invito
      // (M7-AUDIT-3P-R1): UUID canonico, come lo genera `crypto.randomUUID()`.
      // Maiuscole ammesse, coerentemente con il validatore degli helper
      // (`functions/audit-event-service.js:34`, regex case-insensitive).
      function isOpaqueInviteRef(value) {
        return value is string &&
          value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
      }
      // `responseAuditRef` lo scrive **solo** la callable Admin, che ignora le
      // Rules. Un client non può inserirlo né modificarlo (compreso inserirlo
      // nullo, che il trigger leggerebbe come assente), ma può **conservarlo
      // invariato**: gli aggiornamenti di merge (`updateDoc`, `transaction.update`)
      // non lo toccano e il campo resta nel documento risultante — è il caso di
      // «rifiutato → Archivia» e dell'archiviazione/ripristino dell'Account.
      // Può anche **rimuoverlo**, perché la `set` senza merge del reinvito
      // sostituisce il documento e scrive un `auditRef` nuovo: la base vecchia
      // appartiene a un'istanza morta. Limite dichiarato (D-8, decisione di Diego
      // del 21/09/2026): la rimozione isolata resta possibile e tocca solo il
      // registro best-effort di chi la esegue.
      function keepsResponseAuditRef() {
        return !request.resource.data.keys().hasAny(['responseAuditRef']) ||
          (resource.data.keys().hasAny(['responseAuditRef']) &&
            request.resource.data.get('responseAuditRef', null) == resource.data.get('responseAuditRef', null));
      }
      // Backend-only binding: preserve unchanged or remove for legacy full-replace.
      function keepsAcceptanceReceipt() {
        return !request.resource.data.keys().hasAny(['acceptanceReceipt']) ||
          (resource.data.keys().hasAny(['acceptanceReceipt']) &&
            request.resource.data.get('acceptanceReceipt', null) == resource.data.get('acceptanceReceipt', null));
      }

      allow get, list: if isInviteOwner() || isRecipient();
      allow create: if isAuth() &&
        request.resource.data.keys().hasOnly([
          'inviteId', 'recipientEmail', 'accountId', 'accountName',
          'ownerId', 'senderId', 'senderEmail', 'aziendaId', 'type',
          'status', 'createdAt', 'notifyPush', 'notifyEmail', 'cycle',
          // M7-AUDIT-5R: marcatore opaco dell'istanza, scritto dai client di
          // M7-AUDIT-5C. **Facoltativo**: un client in cache che non lo invia
          // continua a creare inviti (finestra legacy dichiarata); se presente
          // deve avere forma valida, altrimenti l'id del registro non sarebbe
          // derivabile in modo univoco.
          'auditRef'
        ]) &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        request.resource.data.get('senderId', '') == request.auth.uid &&
        request.resource.data.get('senderEmail', '').lower() == myEmail() &&
        request.resource.data.get('recipientEmail', '') is string &&
        request.resource.data.get('recipientEmail', '').size() > 3 &&
        request.resource.data.get('notifyPush', false) is bool &&
        request.resource.data.get('notifyEmail', false) is bool &&
        request.resource.data.get('status', '') == 'pending' &&
        // M7-R7C-1: `cycle` è l'unico campo nuovo ammesso e deve essere un intero
        // sicuro non negativo. L'assenza resta valida (creazioni legacy = ciclo 0).
        request.resource.data.get('cycle', 0) is int &&
        request.resource.data.get('cycle', 0) >= 0 &&
        request.resource.data.get('cycle', 0) <= 9007199254740991 &&
        (!request.resource.data.keys().hasAny(['auditRef']) ||
          isOpaqueInviteRef(request.resource.data.get('auditRef', '')));

      // M7-AUDIT-5R — campi aggiornabili ristretti (decisione D-6 di Codex del
      // 21/09/2026, allowlist verificata in M7-AUDIT-5P-R1 §3). `affectedKeys()`
      // comprende le chiavi **rimosse**, quindi l'elenco contiene anche i campi
      // che il reinvito full-replace fa sparire (`guestUid`, `respondedAt`,
      // `responseAuditRef`, `sharingState`, `suspendedAt`, `senderNotified`) e
      // `cycle`, che il primo update di un invito legacy senza ciclo aggiunge con
      // valore 0. Restano fuori `ownerId`, `senderId`, `senderEmail`,
      // `recipientEmail`, `inviteId`, `accountId`, `aziendaId`: invariati in tutti
      // i flussi censiti, quindi una loro modifica è negata.
      allow update: if isInviteOwner() &&
        keepsResponseAuditRef() &&
        keepsAcceptanceReceipt() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'auditRef', 'status', 'cycle', 'createdAt', 'accountName', 'type',
          'notifyPush', 'notifyEmail', 'senderNotified', 'sharingState',
          'suspendedAt', 'guestUid', 'respondedAt', 'responseAuditRef', 'acceptanceReceipt'
        ]) &&
        (!request.resource.data.keys().hasAny(['auditRef']) ||
          isOpaqueInviteRef(request.resource.data.get('auditRef', '')));

      // La revoca resta al proprietario, senza vincoli di campo: `delete` non
      // scrive nulla e non ha campi da limitare.
      allow delete: if isInviteOwner();
    }
  }
}
