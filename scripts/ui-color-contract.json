      "backgroundRole": "--rev-icon-bg",
      "minContrast": 3
    },
    {
      "id": "settings-theme-icon-amber",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".settings-icon-box.icon-amber[data-icon-role=\"theme\"]",
      "markup": "<div class=\"settings-icon-box icon-amber\" data-icon-role=\"theme\">x</div>",
      "foregroundRole": "--rev-icon",
      "backgroundRole": "--rev-icon-bg",
      "minContrast": 3
    },
    {
      "id": "settings-theme-icon-red",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".settings-icon-box.icon-red[data-icon-role=\"theme\"]",
