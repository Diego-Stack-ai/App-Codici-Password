{
  "schemaVersion": 1,
  "scope": "Local CSS fixtures only; not a certification of every page, state or device",
  "paletteSource": "Frontend/public/assets/css/core.css",
  "roleSource": "Frontend/public/assets/css/core_ui.css",
  "palettes": [
    "",
    "green",
    "red",
    "sand",
    "petrol",
    "lavender",
    "dusty-rose"
  ],
  "themes": [
    "light",
    "dark"
  ],
  "lazyStylesheets": [
    "assets/css/vault-assistant.css"
  ],
  "pages": [
    "impostazioni.html",
    "profilo_privato.html",
    "dati_azienda.html",
    "configurazione_documenti.html",
    "gestione_destinatari.html",
    "form_account_privato.html",
    "regole_scadenze.html",
    "dettaglio_account_privato.html"
  ],
  "components": [
    {
      "id": "settings-secondary",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".settings-item .settings-desc",
      "markup": "<div class=\"settings-item\"><span class=\"settings-desc\">Descrizione sintetica</span></div>",
      "foregroundRole": "--text-secondary",
      "backgroundRole": "--rev-surface",
      "minContrast": 4.5
    },
    {
      "id": "settings-popup-secondary",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".modal-box .settings-desc",
      "markup": "<div class=\"modal-box\"><span class=\"settings-desc\">Conferma sintetica</span></div>",
      "foregroundRole": "--text-secondary",
      "backgroundRole": "--rev-popup",
      "minContrast": 4.5
    },
    {
      "id": "settings-icon",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".settings-icon-box",
      "markup": "<div class=\"settings-icon-box\">x</div>",
      "foregroundRole": "--rev-icon",
      "backgroundRole": "--rev-icon-bg",
      "minContrast": 3
    },
    {
      "id": "company-purple",
      "pages": [
        "dati_azienda.html"
      ],
      "selector": ".settings-icon-box.icon-purple",
      "markup": "<div class=\"settings-icon-box icon-purple\">x</div>",
      "foregroundRole": "white",
      "backgroundRole": "--rev-fill",
      "minContrast": 4.5
    },
    {
      "id": "company-blue",
      "pages": [
        "dati_azienda.html"
      ],
      "selector": ".settings-icon-box.icon-blue",
      "markup": "<div class=\"settings-icon-box icon-blue\">x</div>",
      "foregroundRole": "white",
      "backgroundRole": "--rev-fill",
      "minContrast": 4.5
    },
    {
      "id": "manage-pressed",
      "pages": [
        "profilo_privato.html",
        "dati_azienda.html"
      ],
      "selector": ".manage-toggle[aria-pressed=true]",
      "markup": "<button class=\"manage-toggle\" type=\"button\" aria-pressed=\"true\">Fine</button>",
      "foregroundRole": "white",
      "backgroundRole": "--rev-fill",
      "minContrast": 4.5
    },
    {
      "id": "search-panel",
      "selector": ".vault-assistant-panel",
      "markup": "<section class=\"vault-assistant-panel\">Ricerca sintetica</section>",
      "foregroundRole": "--text-primary",
      "backgroundRole": "--rev-popup",
      "backgroundImage": "none",
      "minContrast": 4.5
    },
    {
      "id": "search-user-bubble",
      "selector": ".vault-assistant-bubble.user",
      "markup": "<div class=\"vault-assistant-panel\"><div class=\"vault-assistant-bubble user\">Domanda sintetica</div></div>",
      "foregroundRole": "white",
      "backgroundRole": "--rev-fill",
      "minContrast": 4.5
    },
    {
      "id": "search-microphone",
      "selector": ".vault-assistant-microphone",
      "markup": "<div class=\"vault-assistant-panel\"><button class=\"vault-assistant-microphone\" type=\"button\">m</button></div>",
      "foregroundRole": "white",
      "backgroundRole": "--rev-fill",
      "minContrast": 4.5
    },
    {
      "id": "config-badge-accent",
      "pages": [
        "configurazione_documenti.html"
      ],
      "selector": ".config-badge.config-badge-blue",
      "markup": "<span class=\"config-badge config-badge-blue\">[Doc]</span>",
      "foregroundRole": "--rev-text-accent",
      "backgroundRole": "--rev-icon-bg",
      "minContrast": 4.5
    },
    {
      "id": "recipient-count",
      "pages": [
        "gestione_destinatari.html"
      ],
      "selector": ".recipient-count",
      "markup": "<span class=\"recipient-count\">3</span>",
      "foregroundRole": "--rev-text-accent",
      "backgroundRole": "--rev-icon-bg",
      "minContrast": 4.5
    },
    {
      "id": "account-option-icon",
      "pages": [
        "form_account_privato.html"
      ],
      "selector": ".icon-accent-purple.bg-purple-soft",
      "markup": "<span class=\"material-symbols-outlined icon-accent-purple bg-purple-soft option-icon\">x</span>",
      "foregroundRole": "--rev-icon",
      "backgroundRole": "--rev-icon-bg",
      "minContrast": 3
    },
    {
      "id": "rules-arrow",
      "pages": [
        "regole_scadenze.html"
      ],
      "selector": ".arrow-icon.text-secondary",
      "markup": "<div class=\"settings-item\"><a href=\"#\"><span class=\"material-symbols-outlined arrow-icon text-secondary\">x</span></a></div>",
      "foregroundRole": "--text-secondary",
      "backgroundRole": "--rev-surface",
      "minContrast": 3
    },
    {
      "id": "settings-maintenance-card",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".btn-maintenance-accent",
      "markup": "<div class=\"settings-item\"><button class=\"btn-maintenance-accent\" type=\"button\">Copia rapporto</button></div>",
      "foregroundRole": "--settings-action-text",
      "backgroundRole": "--rev-surface-2",
      "backgroundImage": "none",
      "minContrast": 4.5,
      "states": [
        "hover",
        "focus"
      ]
    },
    {
      "id": "settings-maintenance-standalone",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".btn-maintenance-accent",
      "markup": "<button class=\"btn-maintenance-accent\" type=\"button\">Copia rapporto</button>",
      "foregroundRole": "--settings-action-text",
      "backgroundRole": "--rev-surface-2",
      "backgroundImage": "none",
      "minContrast": 4.5,
      "states": [
        "hover",
        "focus"
      ]
    },
    {
      "id": "settings-theme-icon-purple",
      "pages": [
        "impostazioni.html"
      ],
      "selector": ".settings-icon-box.icon-purple[data-icon-role=\"theme\"]",
      "markup": "<div class=\"settings-icon-box icon-purple\" data-icon-role=\"theme\">x</div>",
      "foregroundRole": "--rev-icon",
      "backgroundRole": "--rev-icon-bg",
      "minContrast": 3
    },
