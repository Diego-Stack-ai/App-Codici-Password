      "minContrast": 3
    },
    {
      "id": "profile-theme-icon-amber",
      "pages": [
        "profilo_privato.html"
      ],
      "selector": ".settings-icon-box.icon-amber",
      "markup": "<div class=\"settings-icon-box icon-amber\" data-icon-role=\"theme\">x</div>",
      "foregroundRole": "--rev-icon",
