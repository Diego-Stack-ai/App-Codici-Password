      "backgroundImage": "none",
      "minContrast": 4.5
    },
    {
      "id": "toast-message",
      "selector": ".toast-content .toast-text",
      "markup": "<div id=\"toast\" class=\"active\"><div class=\"toast-content\"><span class=\"toast-text\">Salvato</span></div></div>",
      "foregroundRole": "--text-primary",
      "backgroundRole": "--rev-popup",
      "minContrast": 4.5
    },
    {
      "id": "profile-theme-icon-emerald",
      "pages": [
        "profilo_privato.html"
      ],
      "selector": ".settings-icon-box.icon-emerald",
      "markup": "<div class=\"settings-icon-box icon-emerald\" data-icon-role=\"theme\">x</div>",
      "foregroundRole": "--rev-icon",
