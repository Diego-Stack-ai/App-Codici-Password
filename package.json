{
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "esbuild": "^0.28.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.28.2",
    "madge": "^8.0.0",
    "stylelint": "^17.1.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "name": "appcodicipassword",
  "version": "1.2.40",
  "description": "PWA Firebase per la gestione cifrata di account, aziende e scadenze.",
  "private": true,
  "scripts": {
    "version:bump": "node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:check": "node scripts/bump-version.mjs --check",
    "build:offline-runtime": "node scripts/build-offline-runtime.mjs",
    "migrate:offline-reads": "node scripts/migrate-offline-firestore-reads.mjs",
    "pretest": "npm run build:offline-runtime",
    "release:patch": "npm run version:patch && npm test",
    "test": "npm run test:offline && npm run test:security && npm run test:navigation && npm run test:ui-foundations && npm run test:html-purity && npm run test:static-references && npm run test:js-syntax && npm run test:css && npm run test:dependencies && npm run test:assistant && npm run test:profile && npm run test:crypto && npm run test:attachments && npm run test:functions-security && npm run test:firestore-rules && npm run test:storage-rules",
    "test:offline": "node scripts/audit-offline-shell.mjs",
    "test:security": "node scripts/audit-security-flows.mjs",
    "test:navigation": "node scripts/audit-navigation-flows.mjs",
    "test:ui-foundations": "node scripts/audit-ui-foundations.mjs",
    "test:html-purity": "node scripts/audit-html-purity.mjs",
    "test:static-references": "node scripts/audit-static-references.mjs",
    "test:js-syntax": "node scripts/audit-js-syntax.mjs",
    "test:crypto": "node --test tests/crypto-utils.test.mjs",
    "test:attachments": "node --test tests/attachment-security.test.mjs",
    "test:functions-security": "node --check functions/index.js && node --check functions/recovery-security.js && node functions/node_modules/eslint/bin/eslint.js --config functions/eslint.config.js functions && node --test functions/test/recovery-security.test.js",
    "test:storage-rules": "node scripts/run-storage-rules-tests.mjs",
    "test:firestore-rules": "node scripts/run-firestore-rules-tests.mjs",
    "test:assistant": "node scripts/test-vault-assistant.mjs",
    "test:profile": "node --test tests/profile-model.test.mjs",
    "test:css": "node node_modules/stylelint/bin/stylelint.mjs \"Frontend/public/assets/css/**/*.css\"",
    "test:dependencies": "node node_modules/madge/bin/cli.js Frontend/public/assets/js --extensions js --circular",
    "audit:inventory": "node scripts/audit-project-inventory.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diego-Stack-ai/App-Codici-Password.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Diego-Stack-ai/App-Codici-Password/issues"
  },
  "homepage": "https://github.com/Diego-Stack-ai/App-Codici-Password#readme"
}
