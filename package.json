    "version:bump": "node scripts/bump-version.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release:patch": "npm run version:patch && npm test",
    "test": "npm run test:security && npm run test:crypto && npm run test:attachments && npm run test:functions-security && npm run test:storage-rules",
    "test:security": "node scripts/audit-security-flows.mjs",
    "test:crypto": "node --test tests/crypto-utils.test.mjs",
